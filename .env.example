# ========================================================
# AI CAREER GUIDANCE PLATFORM - ENVIRONMENT VARIABLES
# ========================================================

# Server Configuration
PORT=5000
NODE_ENV=development
JWT_SECRET=your-secure-random-jwt-secret-string-min-32-chars
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173

# Google Gemini AI Integration (Recommended for live LLM responses)
# Get your API key at: https://aistudio.google.com/
# If left empty, system operates in Intelligent Rule-Based Fallback Mode with honest attribution.
GEMINI_API_KEY=

# Supabase PostgreSQL Database & Auth Configuration
# Get these credentials from your Supabase Project Settings -> API
# If left empty, system operates in Embedded Local Persistent Store mode out-of-the-box.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
